# Optional local Reticulum/LXMF TCP bridge. Use a real LAN IP for a physical
# phone. `localhost` and placeholder hosts are ignored to avoid retry storms.
EXPO_PUBLIC_LOCAL_LXMF_HOST=192.168.x.x
EXPO_PUBLIC_LOCAL_LXMF_PORT=4243
EXPO_PUBLIC_LXMF_LOG_LEVEL=1
# Copy to `.env` (gitignored) and fill in before running.
# All values with EXPO_PUBLIC_ prefix are inlined at build time — never put
# secrets here that you wouldn't ship in a public bundle.

# Crash observability (Sentry) DSN. THIS IS THE KILL SWITCH: leave it unset and
# the app sends ZERO telemetry (Sentry is never initialised). Set it to enable
# crash/error reporting in release builds only — it is always off in __DEV__.
# A DSN is publishable (write-only ingest key), so EXPO_PUBLIC_ is appropriate.
EXPO_PUBLIC_SENTRY_DSN=
# Build-time only: lets the build upload source maps + debug symbols for readable
# stack traces. SENSITIVE (org-scoped) — NOT EXPO_PUBLIC_ (must not be inlined),
# never committed. Set as an EAS secret / CI env. Local release builds without it
# still succeed; symbols just aren't uploaded (run with SENTRY_DISABLE_AUTO_UPLOAD=true).
# SENTRY_AUTH_TOKEN=

# Demo mode pre-fills the send recipient with the shared devnet demo address
# and shows demo-only UI notes. Keep false for normal development and builds.
EXPO_PUBLIC_DEMO_MODE=false

# Optional: dedicated Solana devnet RPC endpoint.
# Leave unset to use the public api.devnet.solana.com endpoint (aggressively
# rate-limited, will trigger 429s under load). For demos / multi-user testing,
# set to a free-tier Helius / QuickNode / Triton devnet URL, e.g.
#   EXPO_PUBLIC_SOLANA_RPC=https://devnet.helius-rpc.com/?api-key=your-key
# The URL embeds the rate-limit key. That key is LOW-SENSITIVITY (rate-limit
# only, no signing authority) but still shouldn't land in git — hence `.env`.
EXPO_PUBLIC_SOLANA_RPC=
